# Render API/web service. Copy to .env.prod.api and replace every placeholder.
RENDER_SERVICE_ROLE=web
ASPNETCORE_ENVIRONMENT=Production

DATABASE_URL=postgresql://<dashboard-user>:<password>@<host>:<port>/<database>?sslmode=require
DATABASE_CA_CERT=<aiven-ca-pem-with-escaped-newlines>
DEVICE_DATABASE_CONNECTION=Host=<host>;Port=<port>;Database=<device-database>;Username=<user>;Password=<password>;SSL Mode=VerifyFull;Root Certificate=/run/secrets/aiven-ca.pem
REDIS_URL=rediss://default:<password>@<host>:<port>

JWT_SECRET=<at-least-32-random-bytes>
AAS_PROVISIONING_TOKEN=<different-at-least-32-random-bytes>
INGESTION_API_TOKEN=<different-at-least-32-random-bytes>
DASHBOARD_SERVICE_TOKEN=<different-at-least-32-random-bytes>
ALLOWED_ORIGIN=https://smart-factory-iot-app.vercel.app

MqttBrokerHost=<cloudamqp-mqtt-host>
MqttBrokerPort=8883
MqttUsername=<publisher-user>
MqttPassword=<publisher-password>
MqttUseTls=true
EDGE_SITE_ID=<site-id>
EDGE_LINE_ID=<line-id>

AAS_REPOSITORY_URL=https://<aas-host>/shells
AAS_SUBMODEL_REPOSITORY_URL=https://<aas-host>/submodels
AAS_CONCEPT_DESCRIPTION_REPOSITORY_URL=https://<aas-host>/concept-descriptions
AAS_REGISTRY_URL=https://<aas-host>/shell-registry
AAS_SUBMODEL_REGISTRY_URL=https://<aas-host>/submodel-registry
AASX_FILE_SERVER_URL=https://<aas-host>/packages
AAS_OIDC_TOKEN_URL=https://<aas-host>/oauth/token
AAS_OIDC_DISCOVERY_URL=
AAS_OIDC_CLIENT_ID=<client-id>
AAS_OIDC_CLIENT_SECRET=<client-secret>
AAS_OIDC_SCOPE=
AAS_REPOSITORY_REGISTRY_INTEGRATION=true
AAS_ALLOW_UNAUTHENTICATED_LOCAL=false
AAS_ALLOW_UNAUTHENTICATED_PRIVATE=false

ENABLE_DEMO_ACCOUNTS=true
ENABLE_DEMO_DATA=false
# Transactional email is delivered by the worker; mirror these values when
# validating a complete production environment export.
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=smartfactory.notifications@gmail.com
SMTP_FROM=Smart Factory <smartfactory.notifications@gmail.com>
SMTP_ALLOW_ALL_RECIPIENTS=true
SMTP_ALLOWED_RECIPIENTS=
SMTP_ALLOWED_RECIPIENT_DOMAINS=
EMAIL_DELIVERY_CONFIGURED=true

# Future Resend switch after verifying your domain:
# EMAIL_PROVIDER=resend
RESEND_API_KEY=<key>
RESEND_FROM=Smart Factory <notifications@your-domain.com>
RESEND_ALLOWED_RECIPIENT_DOMAINS=your-domain.com
