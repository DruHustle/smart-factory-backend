# HISTORICAL ONLY: outside the supported Vercel/single-Render-container release.
# Smart Factory Backend - Cloudflare template (TelemetryService)
# Use this for the Cloudflare deployment running TelemetryService.

ASPNETCORE_ENVIRONMENT=Production
SERVICE_NAME=TelemetryService

# Data + messaging
PostgresConnectionString=Host=<POSTGRES_HOST>;Port=<POSTGRES_PORT>;Database=<POSTGRES_DB>;Username=<POSTGRES_USER>;Password=<POSTGRES_PASSWORD>;SSL Mode=VerifyFull;Root Certificate=/run/secrets/aiven-ca.pem;
ConnectionStrings__DefaultConnection=Host=<POSTGRES_HOST>;Port=<POSTGRES_PORT>;Database=<POSTGRES_DB>;Username=<POSTGRES_USER>;Password=<POSTGRES_PASSWORD>;SSL Mode=VerifyFull;Root Certificate=/run/secrets/aiven-ca.pem;
# Optional MQTT ingestion
MqttBrokerHost=<CLOUDAMQP_MQTT_HOST>
MqttBrokerPort=8883
MqttTopic=factory/+/+/+/telemetry
MqttUsername=<MQTT_USERNAME>
MqttPassword=<MQTT_PASSWORD>
MqttUseTls=true

# Optional service-to-service forwarder to the dashboard API
INTERNAL_TELEMETRY_SINK_URL=https://<dashboard-api>/api/internal/telemetry
INGESTION_API_TOKEN=<same-private-token-configured-on-dashboard-api>

Logging__LogLevel__Default=Information
