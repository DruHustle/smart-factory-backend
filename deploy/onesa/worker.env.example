# Onesa singleton-worker candidate; merge into retained private configuration.
NODE_ENV=production
ASPNETCORE_ENVIRONMENT=Production
DOTNET_ENVIRONMENT=Production
BACKEND_DEPLOYMENT_MODE=render-bundle
RENDER_SERVICE_ROLE=worker
PASSWORD_RESET_ORIGIN=https://factory.onesa.eu
# Use a qualified direct HTTPS API origin, not a guessed public frontend URL.
DASHBOARD_API_ORIGIN=<qualified-direct-https-api-origin>

# Current bundled startup migrations use these same application connections.
DATABASE_URL=postgresql://<dashboard-application-user>:<url-encoded-password>@<current-or-qualified-database-host>:<existing-or-target-port>/<existing-dashboard-database>
DATABASE_SSL_MODE=verify-full
DATABASE_CA_CERT=<trusted-database-ca-pem-with-escaped-newlines>
TELEMETRY_DATABASE_CONNECTION=Host=<current-or-qualified-database-host>;Port=<existing-or-target-port>;Database=<existing-telemetry-database>;Username=<telemetry-application-user>;Password=<existing-secret>;SSL Mode=VerifyFull;Root Certificate=/run/secrets/aiven-ca.pem
INGESTION_API_TOKEN=<preserve-existing-api-worker-token>
DASHBOARD_SERVICE_TOKEN=<preserve-existing-api-worker-service-token>

MqttBrokerHost=<preserve-existing-qualified-broker-host>
MqttBrokerPort=<preserve-existing-tls-broker-port>
MqttUsername=<preserve-existing-subscriber-user>
MqttPassword=<preserve-existing-subscriber-secret>
MqttUseTls=true
MqttClientId=<preserve-existing-singleton-client-id>
MqttTopic=factory/+/+/+/telemetry
MqttHeartbeatTopic=factory/+/+/+/heartbeat

EMAIL_PROVIDER=resend
RESEND_API_KEY=<verified-domain-scoped-resend-key>
RESEND_FROM=Smart Factory <notifications@factory.onesa.eu>
RESEND_ALLOWED_RECIPIENT_DOMAINS=<preserve-approved-recipient-domains>
# Recipient policy controls recipients; it is independent of sender-domain DNS.
