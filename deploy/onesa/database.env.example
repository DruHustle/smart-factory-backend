# Optional isolated database candidate. This does not select an application primary.
FACTORY_POSTGRES_IMAGE=postgres:<source-compatible-version>@sha256:<reviewed-image-digest>
FACTORY_POSTGRES_PLATFORM=<qualified-linux-platform>
FACTORY_POSTGRES_UID=<postgres-uid-from-reviewed-image>
FACTORY_POSTGRES_GID=<postgres-gid-from-reviewed-image>
FACTORY_POSTGRES_MEMORY_LIMIT=<capacity-qualified-memory-limit>
FACTORY_POSTGRES_CPU_LIMIT=<capacity-qualified-cpu-limit>
FACTORY_POSTGRES_SHM_SIZE=<capacity-qualified-shared-memory-limit>
FACTORY_POSTGRES_MAX_CONNECTIONS=<capacity-qualified-connection-limit>
FACTORY_POSTGRES_VOLUME=<existing-reviewed-durable-volume-name>
FACTORY_POSTGRES_PASSWORD_FILE=<absolute-private-bootstrap-password-file>
FACTORY_POSTGRES_TLS_DIR=<absolute-private-directory-with-server.crt-server.key>
