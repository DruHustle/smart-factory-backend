# Onesa candidate fields to merge into retained private configuration.
# Never replace a live environment with this incomplete example.
NODE_ENV=production
ASPNETCORE_ENVIRONMENT=Production
DOTNET_ENVIRONMENT=Production
BACKEND_DEPLOYMENT_MODE=render-bundle
RENDER_SERVICE_ROLE=web
ALLOWED_ORIGIN=https://factory.onesa.eu
PASSWORD_RESET_ORIGIN=https://factory.onesa.eu

# Preserve the current external primary until a restored candidate is qualified.
# The combined image runs startup migrations using these application connections.
DATABASE_URL=postgresql://<dashboard-application-user>:<url-encoded-password>@<current-or-qualified-database-host>:<existing-or-target-port>/<existing-dashboard-database>
DATABASE_SSL_MODE=verify-full
DATABASE_CA_CERT=<trusted-database-ca-pem-with-escaped-newlines>
DEVICE_DATABASE_CONNECTION=Host=<current-or-qualified-database-host>;Port=<existing-or-target-port>;Database=<existing-device-database>;Username=<device-application-user>;Password=<existing-secret>;SSL Mode=VerifyFull;Root Certificate=/run/secrets/aiven-ca.pem
REDIS_URL=<preserve-existing-verified-redis-connection>

JWT_SECRET=<preserve-existing-signing-secret>
AAS_PROVISIONING_TOKEN=<preserve-existing-aas-provisioning-token>
INGESTION_API_TOKEN=<preserve-existing-api-worker-token>
DASHBOARD_SERVICE_TOKEN=<preserve-existing-api-worker-service-token>

# Delivery belongs to the singleton worker; no provider key belongs in the API.
EMAIL_PROVIDER=resend
EMAIL_DELIVERY_CONFIGURED=false
# Set this true only after qualified worker delivery, reset redemption and policy checks.
# Preserve the remaining MQTT publisher, edge, AAS/OIDC, demo and runtime values.
