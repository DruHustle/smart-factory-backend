# Copy to .env.local, replace every CHANGE_ME value, then run:
# docker compose --env-file .env.local up --build -d --wait
POSTGRES_USER=smartfactory_local
POSTGRES_PASSWORD=CHANGE_ME_UNIQUE_LOCAL_DATABASE_PASSWORD
POSTGRES_DB=SmartFactory
APPLY_DATABASE_MIGRATIONS=true

RABBITMQ_DEFAULT_USER=smartfactory_local
RABBITMQ_DEFAULT_PASS=CHANGE_ME_UNIQUE_LOCAL_BROKER_PASSWORD

EDGE_COMMAND_MQTT_HOST=rabbitmq
EDGE_COMMAND_MQTT_PORT=1883
EDGE_COMMAND_MQTT_USERNAME=smartfactory_local
EDGE_COMMAND_MQTT_PASSWORD=CHANGE_ME_UNIQUE_LOCAL_BROKER_PASSWORD
EDGE_COMMAND_MQTT_USE_TLS=false
TELEMETRY_MQTT_HOST=rabbitmq
TELEMETRY_MQTT_PORT=1883
TELEMETRY_MQTT_USERNAME=smartfactory_local
TELEMETRY_MQTT_PASSWORD=CHANGE_ME_UNIQUE_LOCAL_BROKER_PASSWORD
TELEMETRY_MQTT_USE_TLS=false
TELEMETRY_MQTT_TOPIC=factory/+/+/+/telemetry
TELEMETRY_MQTT_HEARTBEAT_TOPIC=factory/+/+/+/heartbeat

JWT_SECRET=CHANGE_ME_RANDOM_SECRET_OF_AT_LEAST_32_BYTES
AAS_PROVISIONING_TOKEN=CHANGE_ME_DIFFERENT_RANDOM_SECRET_OF_AT_LEAST_32_BYTES
INGESTION_API_TOKEN=CHANGE_ME_DIFFERENT_RANDOM_SECRET_OF_AT_LEAST_32_BYTES
DASHBOARD_SERVICE_TOKEN=CHANGE_ME_DIFFERENT_RANDOM_SECRET_OF_AT_LEAST_32_BYTES

DASHBOARD_DATABASE_CONNECTION=Host=database;Database=smart_factory_iot;Username=smartfactory_local;Password=CHANGE_ME_DASHBOARD_DATABASE_PASSWORD;SSL Mode=Disable
INTERNAL_TELEMETRY_SINK_URL=http://dashboard:3000/api/internal/telemetry

REDIS_PASSWORD=CHANGE_ME_UNIQUE_LOCAL_REDIS_PASSWORD
DEVICE_SERVICE_REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379

AAS_REPOSITORY_URL=http://aas-repository:8081
AAS_SUBMODEL_REPOSITORY_URL=http://submodel-repository:8083
AAS_CONCEPT_DESCRIPTION_REPOSITORY_URL=http://concept-description-repository:8085
AAS_REGISTRY_URL=http://aas-registry:8082
AAS_SUBMODEL_REGISTRY_URL=http://submodel-registry:8084
AASX_FILE_SERVER_URL=http://aasx-file-server:8086
AAS_REPOSITORY_REGISTRY_INTEGRATION=true
AAS_ALLOW_UNAUTHENTICATED_LOCAL=true
AAS_ALLOW_UNAUTHENTICATED_PRIVATE=false
AAS_OIDC_TOKEN_URL=
AAS_OIDC_DISCOVERY_URL=
AAS_OIDC_SCOPE=
AAS_OIDC_CLIENT_ID=
AAS_OIDC_CLIENT_SECRET=

EDGE_SITE_ID=factory-a
EDGE_LINE_ID=line-1

EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=smartfactory.notifications@gmail.com
SMTP_PASSWORD=
SMTP_FROM=Smart Factory <smartfactory.notifications@gmail.com>
SMTP_ALLOW_ALL_RECIPIENTS=true
SMTP_ALLOWED_RECIPIENTS=
SMTP_ALLOWED_RECIPIENT_DOMAINS=

# Future Resend switch after verifying your domain:
# EMAIL_PROVIDER=resend
RESEND_API_KEY=
RESEND_FROM=Smart Factory <notifications@your-domain.com>
RESEND_ALLOWED_RECIPIENT_DOMAINS=your-domain.com

#Demo accounts and demo data 
ENABLE_DEMO_ACCOUNTS=true
ENABLE_DEMO_DATA=true
